FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    OMP_NUM_THREADS=2 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=2

WORKDIR /srv/app
RUN apt-get update \
    && apt-get install -y --no-install-recommends tesseract-ocr fonts-dejavu-core libgomp1 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml README.md ./
COPY app ./app
COPY scripts ./scripts
RUN python -m pip install --no-cache-dir '.[ocr]' \
    && python -c 'import rapidocr, onnxruntime; print("Benchmark OCR installed")'

RUN groupadd --system bench && useradd --system --gid bench --create-home bench
USER bench
ENTRYPOINT ["python", "scripts/benchmark_ocr.py"]
CMD ["--synthetic", "--tessdata-dir", "/models/benchmark", "--output", "/reports/ocr_benchmark.json"]
