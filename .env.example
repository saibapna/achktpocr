APP_ENV=development
APP_API_KEY=replace-with-a-long-random-secret
APP_UPLOAD_MAX_BYTES=10485760
APP_MAX_IMAGE_DIMENSION=8000
APP_MAX_IMAGE_PIXELS=16000000
APP_OCR_MAX_SIDE=2500
APP_OCR_ENABLED=true
APP_MODEL_MANIFEST=models/manifest.json
APP_LOG_LEVEL=INFO
OCR_BIND_IP=127.0.0.1

# Optional dataset collector (never commit the real .env):
HF_TOKEN=
ROBOFLOW_API_KEY=
# Change to your local numeric UID/GID if your bind mount is inaccessible.
DATASET_UID=1000
DATASET_GID=1000
